{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theirs-page",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAElC6yv2vY7dR2dn",
    "TURNSTILE_SECRET_KEY": "0x4AAAAAAElC6-LxRLOkIkSeI_RiGUGFt4o"
  }
}

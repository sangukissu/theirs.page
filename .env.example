# ==============================================================================
# CLOUDFLARE WORKERS CONFIGURATION GUIDE
# ==============================================================================
# In Cloudflare Dashboard (Workers & Pages > theirs-page > Settings > Variables and Secrets):
#
# 1. "Variables and secrets" (Build environment variables):
#    Required during `npm run build` / `next build`. Next.js bakes all NEXT_PUBLIC_*
#    variables into client-side JavaScript bundles at build time.
#
# 2. "Runtime variables and secrets":
#    Injected into your Worker at runtime on Cloudflare's edge. All backend API
#    keys, database credentials, R2 storage secrets, and payment tokens belong here.
#
# TIP: Add NEXT_PUBLIC_* variables to BOTH Build and Runtime so that server
# components and API routes can also access them dynamically at runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BUILD VARIABLES (Add to Cloudflare Build Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://theirs.page
NEXT_PUBLIC_APP_URL=https://theirs.page
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# Optional: Microsoft Clarity analytics (leave blank if not using)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Required at build time because next.config.js passes it to the client environment:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ------------------------------------------------------------------------------
# 2. RUNTIME VARIABLES & SECRETS (Add to Cloudflare Runtime Variables and Secrets)
# Sensitive keys should be created as "Secret" (encrypted) in Cloudflare.
# ------------------------------------------------------------------------------
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Google Gemini AI (editorial engine, image analysis)
GEMINI_API_KEY=AIzaSy...
GEMINI_SAFETY_MODEL=gemini-2.5-flash-lite

# Fal.ai (photo restoration only)
FAL_KEY=...
# Optional only if a selected FAL model returns media from another documented host.
FAL_MEDIA_ALLOWED_HOSTS=

# Resend (transactional emails)
RESEND_API_KEY=re_...

# Cloudflare Turnstile (Server-side captcha verification)
TURNSTILE_SECRET_KEY=0x4AAAAAA...
TURNSTILE_EXPECTED_HOSTNAMES=theirs.page,www.theirs.page

# Dodo Payments (Memorial activations & checkout)
DODO_ENV=test
DODO_PRODUCT_ID=pdt_...
DODO_PAYMENTS_API_KEY=...
DODO_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 Storage (Direct browser upload & media pipeline)
R2_ACCOUNT_ID=...
R2_BUCKET_NAME=theirs
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
# Public delivery hostname routed to the Theirs application worker. Do not
# attach this hostname directly to the mixed private R2 bucket.
R2_MEDIA_ENDPOINT=https://media.theirs.page
# Optional comma-separated public endpoints previously stored in database rows.
# Keep this only so the app can translate old URLs to /api/media; disable the
# bucket's r2.dev public URL in Cloudflare before production.
R2_LEGACY_MEDIA_ENDPOINTS=https://pub-example.r2.dev

# HMAC signing. Generate independent random values (at least 32 bytes each).
# SUPABASE_SECRET_KEY is accepted as a temporary fallback, but independent
# secrets make rotation safer.
CONTRIBUTION_SIGNING_SECRET=
INVITATION_SIGNING_SECRET=
PIN_SIGNING_SECRET=
PIN_HASH_SECRET=
RATE_LIMIT_HASH_SECRET=

# Cleanup Cron Secret (Bearer token for /api/cron/cleanup-temp)
CRON_SECRET=

# Memory Book (Optional - defaults to SUPABASE_SECRET_KEY if omitted)
MEMORY_BOOK_SHARE_SECRET=
MEMORY_BOOK_WORKER_SECRET=
